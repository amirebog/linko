# Bind address. Default is loopback for local development.
LINKO_HOST=127.0.0.1
LINKO_PORT=3000

# SQLite database file. Created automatically on first start.
LINKO_DATABASE_PATH=data/linko.db

# Session lifetime in hours (default 168 = 7 days).
LINKO_SESSION_HOURS=168

# Set to true when serving over HTTPS so cookies get the Secure flag.
LINKO_SECURE_COOKIES=false

# Optional. After this user registers, restart with this variable set to
# promote them to admin IF no administrator exists yet.
# Never grants admin on public registration.
LINKO_BOOTSTRAP_ADMIN=

# Logging. Examples: info, debug, linko=debug,sqlx=warn
RUST_LOG=info

# Optional override for templates/ and static/ (defaults to this crate directory).
# LINKO_ASSET_ROOT=
